APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY=

# Optional AI itinerary drafts. Buyers supply their own provider credentials.
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional internal knowledge retrieval. Choose OpenAI or Gemini independently of AI_PROVIDER.
AI_KNOWLEDGE_ENABLED=false
AI_AGENT_ACTIONS_ENABLED=false
# Optional remote READ-only MCP server. Create bearer tokens in Admin > MCP Access.
MCP_ENABLED=false
AI_EMBEDDING_PROVIDER=openai
# For Gemini embeddings, set provider=gemini and model=gemini-embedding-2.
AI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
# Optional Microsoft Foundry / Azure OpenAI v1 Responses deployment.
# AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# AZURE_FOUNDRY_DEPLOYMENT=
# AZURE_FOUNDRY_API_KEY=
# AZURE_FOUNDRY_TOOL_CALLING=false
